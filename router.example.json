      "latency_ms": 2200,
      "quality": {
        "general": 0.82,
        "code": 0.93,
        "math": 0.84,
        "research": 0.80
      }
    },
    {
      "id": "cloud-scientist",
      "provider": "cloud-b",
      "base_url": "http://127.0.0.1:9103/v1",
